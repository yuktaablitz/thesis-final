# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# --- News (Stage 6) ---
# https://www.cryptocompare.com/cryptopian/api-keys (free tier)
# NOTE: rotate any key that was ever pasted into a notebook/committed anywhere.
CC_API_KEY=

# --- On-chain (Stage 4) ---
# Pick whichever your history/tier allows. CoinMetrics Community API works
# without a key for many metrics; the others require a paid key for full history.
COINMETRICS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=

# --- LLM event classification (Stage 7) ---
# Only one of these is required. Priority: DEEPSEEK_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY
# https://platform.deepseek.com/api_keys — cheapest option, used by default if set.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Binance (optional) ---
# Public market-data endpoints (klines, funding rate, open interest hist) do NOT
# require a key. Only set these if you hit public rate limits and want a higher
# limit via an authenticated (read-only) key. Never use a key with trading permissions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
